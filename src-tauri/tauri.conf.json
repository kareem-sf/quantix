{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantix",
  "version": "0.1.0",
  "identifier": "com.quantix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run bundle:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quantix",
        "create": false,
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/brand-v4/dark/32x32.png",
      "icons/brand-v4/dark/128x128.png",
      "icons/brand-v4/dark/128x128@2x.png",
      "icons/brand-v4/dark/icon.icns",
      "icons/brand-v4/dark/icon.ico"
    ]
  }
}

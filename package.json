{
  "name": "quantix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engineer-controlled Tender Office",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "check:ui": "tsc --noEmit",
    "test:ui": "node scripts/test-ui.mjs",
    "test:backend": "node scripts/python.mjs -m pytest backend/tests -q",
    "test": "npm run test:ui && npm run test:backend",
    "check": "npm run check:ui && node scripts/python.mjs -m ruff check backend && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:check": "prettier --check src scripts *.json *.ts && node scripts/python.mjs -m ruff format --check backend",
    "verify": "npm run check && npm test",
    "bindings": "node scripts/python.mjs scripts/export_openapi.py && node scripts/generate-bindings.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build --config src-tauri/tauri.release.conf.json",
    "bundle:ui": "vite build",
    "package:service": "node scripts/python.mjs scripts/package_service.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2.10.1",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.32.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}

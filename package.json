{
  "name": "quantix",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "check": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features runtime-fixture -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "smoke:codex": "cargo test --manifest-path src-tauri/Cargo.toml --lib agent_runtime::tests::codex_subscription_live_smoke -- --ignored --exact",
    "test": "npm run test:renderer && cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/tests --features runtime-fixture",
    "test:renderer": "vitest run",
    "verify": "npm run format:check && npm run check && npm test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@openai/codex": "0.147.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}

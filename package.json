{
  "name": "quantix",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype:workspace": "vite --host 127.0.0.1 --port 1422 --strictPort --open /prototype.html?variant=A",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "check": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features runtime-fixture -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "acceptance:deterministic": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- deterministic",
    "acceptance:aggregate": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- aggregate",
    "acceptance:live": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- live",
    "acceptance:private": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- private",
    "acceptance:native": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- native",
    "acceptance:release": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- release",
    "release:preflight": "cargo run --manifest-path src-tauri/Cargo.toml --bin quantix-product-acceptance -- release-check",
    "test": "npm run test:renderer && cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/tests --features runtime-fixture -- --test-threads=4",
    "test:renderer": "vitest run",
    "verify:identity": "node scripts/validate-identity-assets.mjs",
    "verify": "npm run verify:identity && npm run format:check && npm run check && npm test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
